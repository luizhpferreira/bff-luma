# Configurações da Aplicação
APP_PORT=8080

# JWT Secret (mude em produção!)
JWT_SECRET=your_jwt_secret_here_change_in_production

# LNBits Configuration
LNBITS_BASE_URL=http://172.19.0.5:5000
LNBITS_API_TOKEN=your_lnbits_api_token_here

LNBITS_WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration (PostgreSQL)
POSTGRES_DB=bff_luma
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgres://postgres:your_postgres_password_here@localhost:5433/bff_luma?sslmode=disable

# SMTP Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_from_email@example.com
SMTP_FROM_NAME=Your App Name
SMTP_USE_TLS=true

# BFF Database Configuration
BFF_POSTGRES_DB=bff_luma
BFF_POSTGRES_USER=postgres
BFF_POSTGRES_PASSWORD=your_bff_postgres_password_here

# Domain Configuration (para produção com cloudflared)
APP_DOMAIN=your_domain.com
APP_PROTOCOL=https

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# LNBits Database Configuration
LNBITS_POSTGRES_DB=lnbits
LNBITS_POSTGRES_USER=lnbits
LNBITS_POSTGRES_PASSWORD=your_lnbits_postgres_password_here
LNBITS_POSTGRES_HOST=172.19.0.3
LNBITS_POSTGRES_PORT=5432

LNBITS_DATABASE_URL=postgres://lnbits:your_lnbits_postgres_password_here@postgres:5432/lnbits?sslmode=disable
