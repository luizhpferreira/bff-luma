# Configurações da Aplicação
APP_PORT=8080

# JWT Secret (mude em produção!)
JWT_SECRET=your_jwt_secret_here_change_in_production

# LNBits Configuration
LNBITS_BASE_URL=http://host.docker.internal:5000
LNBITS_API_TOKEN=your_lnbits_api_token_here

LNBITS_WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration (PostgreSQL)
POSTGRES_DB=bff_luma
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bff_luma?sslmode=disable

# SMTP Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@bff-luma.com
SMTP_FROM_NAME=BFF Luma
SMTP_USE_TLS=true

# Cloudflare Tunnel (opcional - use apenas se quiser expor via tunnel)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
