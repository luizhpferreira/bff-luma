		},
		{
			"name": "🔄 Testes Automatizados",
			"item": [
				{
					"name": "Criar Carteira com Email Único",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"teste_$(new Date().getTime())\",\n    \"password\": \"{{password}}\",\n    \"password_repeat\": \"{{password}}\"\n}"
