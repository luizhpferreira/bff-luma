						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{api_url}}/admin/rate-limit/stats",
							"host": ["{{api_url}}"],
							"path": ["admin", "rate-limit", "stats"]
						}
					},
					"response": []
				},
				{
					"name": "Limpeza Manual de Tokens",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{api_url}}/admin/cleanup",
							"host": ["{{api_url}}"],
							"path": ["admin", "cleanup"]
						}
					},
					"response": []
				}
			]
		},
